<Window x:Class="DLSSManager.App.ModIniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DLSSManager.App"
        Title="{local:Loc Ini.ModSettings}" Width="940" Height="760" MinWidth="900" MinHeight="490"
        WindowStartupLocation="CenterOwner" Style="{StaticResource CustomCaptionWindow}" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}">
    <Window.Resources>
        <Style x:Key="IniButton" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        </Style>
        <Style x:Key="IniActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IniFileButton" TargetType="Button" BasedOn="{StaticResource IniActionButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IniPresetButton" TargetType="Button" BasedOn="{StaticResource IniActionButton}">
            <Setter Property="Background" Value="#294CAF50"/>
            <Setter Property="BorderBrush" Value="#734CAF50"/>
            <Setter Property="Foreground" Value="#81C784"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IniDeleteButton" TargetType="Button" BasedOn="{StaticResource IniActionButton}">
            <Setter Property="Background" Value="#14EF4444"/>
            <Setter Property="BorderBrush" Value="#52EF4444"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EEF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IniProfileBadge" TargetType="Border" BasedOn="{StaticResource LibraryBadge}">
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#2494A3B8"/>
            <Setter Property="BorderBrush" Value="#4D94A3B8"/>
            <Setter Property="TextElement.Foreground" Value="#CBD5E1"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Game">
                    <Setter Property="Background" Value="#294CAF50"/>
                    <Setter Property="BorderBrush" Value="#6B4CAF50"/>
                    <Setter Property="TextElement.Foreground" Value="#81C784"/>
                </Trigger>
                <Trigger Property="Tag" Value="Global">
                    <Setter Property="Background" Value="#2938BDF8"/>
                    <Setter Property="BorderBrush" Value="#6B38BDF8"/>
                    <Setter Property="TextElement.Foreground" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IniTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Segment" Padding="14,7" CornerRadius="5" Background="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#17FFFFFF"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#294CAF50"/>
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#734CAF50"/>
                                <Setter Property="Foreground" Value="#A5D6A7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Border x:Name="ProfileBadge" DockPanel.Dock="Right" Style="{StaticResource IniProfileBadge}" VerticalAlignment="Top">
                <TextBlock x:Name="ProfileText" Style="{StaticResource LibraryBadgeText}" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <StackPanel>
                <TextBlock Text="{local:Loc Ini.ModSettings}" Style="{StaticResource PageHeading}" Foreground="White" FontWeight="Bold"/>
                <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="#94A3B8"/>
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Foreground="#FFB3B3" TextWrapping="Wrap" Margin="0,8,0,4"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Loc Common.Cancel}" IsCancel="True" Style="{StaticResource IniButton}"/>
                <Button x:Name="SaveButton" Content="{local:Loc Ini.SaveApply}" Style="{StaticResource Primary}" Click="Save"/>
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="Tabs" ItemContainerStyle="{StaticResource IniTabItem}" SelectionChanged="TabSelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="4"
                                Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </DockPanel>
</Window>
