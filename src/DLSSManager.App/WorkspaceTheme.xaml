<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DLSSManager.App"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <SolidColorBrush x:Key="Canvas" Color="#14171D"/>
    <SolidColorBrush x:Key="Panel" Color="#1C2029"/>
    <SolidColorBrush x:Key="Elevated" Color="#252A36"/>
    <SolidColorBrush x:Key="Outline" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="Muted" Color="#A8B0C0"/>
    <SolidColorBrush x:Key="Accent" Color="#76B900"/>
    <SolidColorBrush x:Key="Blue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Purple" Color="#D0A6FF"/>
    <SolidColorBrush x:Key="Sidebar" Color="#181B22"/>
    <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Elevated}"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <SolidColorBrush x:Key="CaptionBackground" Color="#181B20"/>
    <Style x:Key="CustomCaptionWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="local:WindowCaptionBar.UseCustomCaption" Value="True"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="8"
                                    ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid Background="{TemplateBinding Background}">
                        <DockPanel>
                            <local:WindowCaptionBar DockPanel.Dock="Top"/>
                            <AdornerDecorator><ContentPresenter/></AdornerDecorator>
                        </DockPanel>
                        <Border BorderBrush="#262C36" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Style.Resources>
            <SolidColorBrush x:Key="CaptionButtonHover" Color="#2C3441"/>
            <SolidColorBrush x:Key="CaptionButtonPressed" Color="#323A47"/>
            <SolidColorBrush x:Key="CaptionButtonActiveIcon" Color="#F8FAFC"/>
        </Style.Resources>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.120">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <QuadraticEase EasingMode="EaseInOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="ActiveIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="ActiveIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="ButtonFace" Width="40" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False">
                            <Grid.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Grid.Resources>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="HoverSurface" Background="{DynamicResource CaptionButtonHover}" Opacity="0"/>
                            <Border x:Name="PressedSurface" Background="{DynamicResource CaptionButtonPressed}" Opacity="0"/>
                            <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False">
                                <Path x:Name="Icon" Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}"/>
                                <Path x:Name="ActiveIcon" Data="{TemplateBinding Content}" Fill="{DynamicResource CaptionButtonActiveIcon}" Opacity="0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="HoverSurface" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionMinimizeButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Background" Value="#262C36"/>
        <Setter Property="Content">
            <Setter.Value><RectangleGeometry Rect="0,4.25,10,1.5"/></Setter.Value>
        </Setter>
        <Setter Property="ToolTip" Value="Minimieren"/>
        <Setter Property="AutomationProperties.Name" Value="Minimieren"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="CanMinimize">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Resources>
            <SolidColorBrush x:Key="CaptionButtonHover" Color="#DC2626"/>
            <SolidColorBrush x:Key="CaptionButtonPressed" Color="#B91C1C"/>
            <SolidColorBrush x:Key="CaptionButtonActiveIcon" Color="#FFFFFF"/>
        </Style.Resources>
        <Setter Property="Background" Value="#991B1B"/>
        <Setter Property="Content">
            <Setter.Value>
                <PathGeometry Figures="M0,0.8 L0.8,0 L5,4.2 L9.2,0 L10,0.8 L5.8,5 L10,9.2 L9.2,10 L5,5.8 L0.8,10 L0,9.2 L4.2,5 Z"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip" Value="Schließen"/>
        <Setter Property="AutomationProperties.Name" Value="Schließen"/>
    </Style>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#294B80"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C293C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EFF4FF"/>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" CornerRadius="3.5" Background="#333944"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#47505E"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#734CAF50"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="#05FFFFFF" CornerRadius="3.5">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBack" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageForward" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DetailLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,12,0,3"/>
    </Style>
    <Style x:Key="DetailSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="WorkspaceButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Elevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Margin" Value="0,0,8,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#90FFFFFF"/><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource WorkspaceButton}"/>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="#141C09"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="Background" Value="{StaticResource Blue}"/>
        <Setter Property="Foreground" Value="#0B1426"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
    </Style>
    <Style x:Key="InspectorButton" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="#0AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style x:Key="InspectorAccentButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="#294CAF50"/>
                <Setter Property="BorderBrush" Value="#734CAF50"/>
                <Setter Property="Foreground" Value="#81C784"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InspectorGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="InspectorPathButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="#0DFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#244CAF50"/>
                <Setter Property="BorderBrush" Value="#6B4CAF50"/>
                <Setter Property="Foreground" Value="#81C784"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="#244CAF50"/>
                <Setter Property="BorderBrush" Value="#6B4CAF50"/>
                <Setter Property="Foreground" Value="#81C784"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InspectorCopyButton" TargetType="Button" BasedOn="{StaticResource InspectorPathButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="&#xE8C8;"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource InspectorGlyph}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Content" Value="&#xE73E;"/>
                <Setter Property="BorderBrush" Value="#6B4CAF50"/>
                <Setter Property="Foreground" Value="#81C784"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DriverSplitIconButton" TargetType="Button" BasedOn="{StaticResource InspectorPathButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style x:Key="DriverSplitMainButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="WHQL">
                <Setter Property="Background" Value="#244CAF50"/>
                <Setter Property="BorderBrush" Value="#6B4CAF50"/>
                <Setter Property="Foreground" Value="#81C784"/>
            </Trigger>
            <Trigger Property="Tag" Value="Hotfix">
                <Setter Property="Background" Value="#29F59E0B"/>
                <Setter Property="BorderBrush" Value="#73F59E0B"/>
                <Setter Property="Foreground" Value="#FCD34D"/>
            </Trigger>
            <Trigger Property="Tag" Value="Downloading">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#6B38BDF8"/>
                <Setter Property="Foreground" Value="#BAE6FD"/>
            </Trigger>
            <Trigger Property="Tag" Value="Ready">
                <Setter Property="Background" Value="#4CAF50"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
                <Setter Property="Foreground" Value="#102411"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="Tag" Value="Installing">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#5538BDF8"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DriverRollbackSplitMainButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="#14F59E0B"/>
        <Setter Property="BorderBrush" Value="#4DF59E0B"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6,0,0,6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#24F59E0B"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#80F59E0B"/>
                            <Setter Property="Foreground" Value="#FEF3C7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Downloading">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#6B38BDF8"/>
                <Setter Property="Foreground" Value="#BAE6FD"/>
            </Trigger>
            <Trigger Property="Tag" Value="Installing">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#5538BDF8"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DriverRollbackSplitMenuButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="-1,0,0,0"/>
        <Setter Property="Background" Value="#14F59E0B"/>
        <Setter Property="BorderBrush" Value="#4DF59E0B"/>
        <Setter Property="Foreground" Value="#FCD34D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="0,6,6,0" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#26F59E0B"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#80F59E0B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DriverRollbackIconButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="Background" Value="#14F59E0B"/>
        <Setter Property="BorderBrush" Value="#4DF59E0B"/>
        <Setter Property="Foreground" Value="#FCD34D"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#26F59E0B"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#80F59E0B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Downloading">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#6B38BDF8"/>
                <Setter Property="Foreground" Value="#BAE6FD"/>
            </Trigger>
            <Trigger Property="Tag" Value="Installing">
                <Setter Property="Background" Value="#2438BDF8"/>
                <Setter Property="BorderBrush" Value="#5538BDF8"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
