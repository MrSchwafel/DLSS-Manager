<UserControl x:Class="DLSSManager.App.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DLSSManager.App">
    <UserControl.Resources>
        <Style x:Key="RecoveryCard" TargetType="Border">
            <Setter Property="Background" Value="#05FFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="RecoveryPill" TargetType="Border" BasedOn="{StaticResource LibraryBadge}">
            <Setter Property="Background" Value="#263142"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextElement.Foreground" Value="#CBD5E1"/>
            <Setter Property="TextElement.FontSize" Value="11"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BackupTypeBadge" TargetType="Border" BasedOn="{StaticResource RecoveryPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="DLSS">
                    <Setter Property="Background" Value="#294CAF50"/>
                    <Setter Property="TextElement.Foreground" Value="#81C784"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="FG">
                    <Setter Property="Background" Value="#2926A69A"/>
                    <Setter Property="TextElement.Foreground" Value="#80CBC4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="RR">
                    <Setter Property="Background" Value="#29A78BFA"/>
                    <Setter Property="TextElement.Foreground" Value="#C4B5FD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="FSR">
                    <Setter Property="Background" Value="#29F59E0B"/>
                    <Setter Property="TextElement.Foreground" Value="#FCD34D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="XeSS">
                    <Setter Property="Background" Value="#2938BDF8"/>
                    <Setter Property="TextElement.Foreground" Value="#7DD3FC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecoveryAction" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>
        <Style x:Key="RestoreAction" TargetType="Button" BasedOn="{StaticResource RecoveryAction}">
            <Setter Property="Background" Value="#244CAF50"/>
            <Setter Property="BorderBrush" Value="#614CAF50"/>
            <Setter Property="Foreground" Value="#81C784"/>
        </Style>
        <Style x:Key="RestoreAllAction" TargetType="Button" BasedOn="{StaticResource RecoveryAction}">
            <Setter Property="Background" Value="#1FF59E0B"/>
            <Setter Property="BorderBrush" Value="#61F59E0B"/>
            <Setter Property="Foreground" Value="#FCD34D"/>
        </Style>
        <Style x:Key="DeleteBackupAction" TargetType="Button" BasedOn="{StaticResource RecoveryAction}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#29EF4444"/>
                    <Setter Property="Foreground" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecoveryModeItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Segment" Background="Transparent" BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="#384CAF50"/>
                                <Setter Property="Foreground" Value="#81C784"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#81C784"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecoveryRow" TargetType="Border">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0AFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="JournalRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Style="{StaticResource RecoveryRow}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#294CAF50"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#614CAF50"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#81C784"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BackupRowTemplate">
            <Border Style="{StaticResource RecoveryRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="178"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource BackupTypeBadge}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding File}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis"
                               FontFamily="Cascadia Mono, Consolas" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="Backup-Größe" Foreground="#CBD5E1" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Column="3" Text="{Binding Saved}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="Gesichert am" Foreground="#94A3B8" Margin="0,0,22,0" Typography.NumeralAlignment="Tabular"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Style="{StaticResource RestoreAction}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.RestoreFile, RelativeSource={RelativeSource AncestorType=local:RecoveryView}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Wiederherstellen"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeleteBackupAction}" Margin="6,0,0,0"
                                ToolTip="Backup-Datei endgültig löschen" AutomationProperties.Name="Backup-Datei endgültig löschen"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.DeleteBackup, RelativeSource={RelativeSource AncestorType=local:RecoveryView}}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource RestoreAllAction}" MinHeight="34" Command="{Binding RestoreAllGames}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Alle Backups wiederherstellen"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Alle aktualisieren" Command="{Binding BatchUpdate}" Margin="12,0,8,0"/>
                    <Button Content="+ Spiel" Command="{Binding AddGame}" Style="{StaticResource Secondary}" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Wiederherstellung" Style="{StaticResource PageHeading}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource RecoveryPill}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecoverySummary}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,12,0,12" LastChildFill="False">
            <Grid DockPanel.Dock="Right" Width="240" Height="34">
                <TextBox x:Name="BackupSearchBox" Text="{Binding BackupQuery, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" Padding="10,0" AutomationProperties.Name="Spiel oder DLL suchen"/>
                <TextBlock Text="Spiel oder DLL suchen..." Foreground="#94A3B8" IsHitTestVisible="False"
                           Margin="11,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=BackupSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border DockPanel.Dock="Left" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListBox SelectedIndex="{Binding BackupMode, Mode=TwoWay}" ItemContainerStyle="{StaticResource RecoveryModeItem}"
                         Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Wiederherstellungsmodus">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="DLL wiederherstellen" Style="{StaticResource RecoveryModeItem}"/>
                    <ListBoxItem Content="Spiel wiederherstellen" Style="{StaticResource RecoveryModeItem}"/>
                </ListBox>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding BackupGames}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RecoveryCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="BackupDetails" IsChecked="{Binding Expanded, Mode=OneWay}"
                                                  Foreground="#F1F5F9" Background="Transparent"
                                                  AutomationProperties.Name="{Binding Root.Title}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderThickness="1"
                                                        BorderBrush="Transparent" CornerRadius="6" Padding="0,4,6,4">
                                                    <DockPanel>
                                                        <TextBlock x:Name="Chevron" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;"
                                                                   Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <ContentPresenter/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#0AFFFFFF"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#81C784"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Root.Title}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Root.Title}" VerticalAlignment="Center"/>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource RecoveryPill}" Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding CountLabel}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ShortPath}" ToolTip="{Binding Root.Path}" Foreground="#94A3B8"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Grid.Column="1" Content="Spiel wiederherstellen" Style="{StaticResource RestoreAction}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" CommandParameter="{Binding}"
                                            ToolTip="Alle Original-DLLs dieses Spiels wiederherstellen"
                                            Command="{Binding DataContext.RestoreGame, RelativeSource={RelativeSource AncestorType=local:RecoveryView}}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BackupRowTemplate}"
                                              Visibility="{Binding IsChecked, ElementName=BackupDetails, Converter={StaticResource ShowWhenTrue}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding BackupEmptyMessage}" Foreground="#94A3B8" Margin="14,12,14,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleBackups}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3" Style="{StaticResource RecoveryCard}" CornerRadius="8" Margin="0,2,0,0">
            <StackPanel>
                <DockPanel Margin="14,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Journale aktualisieren" Style="{StaticResource RecoveryAction}" Command="{Binding RefreshRecovery}"/>
                        <Button Content="Auswahl wiederherstellen" Style="{StaticResource Primary}" MinHeight="30" Margin="8,0,0,0"
                                Command="{Binding RollbackPending}" Visibility="{Binding HasPendingJournals, Converter={StaticResource ShowWhenTrue}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="#81C784"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingJournals}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="#FCD34D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding PendingJournalHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Keine offenen Datei-Operationen vorhanden." Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingJournals}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <ListBox ItemsSource="{Binding PendingJournals}" SelectedItem="{Binding SelectedJournal}" MaxHeight="170"
                         Visibility="{Binding HasPendingJournals, Converter={StaticResource ShowWhenTrue}}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,4" ItemContainerStyle="{StaticResource JournalRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ausstehende Transaktionen">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Armed, StringFormat={}{0} Dateischritte}"
                                           Foreground="#CBD5E1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Root}" ToolTip="{Binding Root}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Mono}" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
