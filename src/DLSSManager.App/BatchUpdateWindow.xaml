<Window x:Class="DLSSManager.App.BatchUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DLSSManager.App"
        Title="{local:Loc Updates.UpdateAll}" Width="680" Height="480" Style="{StaticResource CustomCaptionWindow}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource DetailSurface}" Padding="10">
                <ListView ItemsSource="{Binding Updates}" AutomationProperties.Name="{local:Loc BatchUpdate.PlannedDLLUpdates}"
                          Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,5">
                                <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Change}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{local:Loc Common.Cancel}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{local:Loc BatchUpdate.ApplyUpdates}" Style="{StaticResource Primary}" Click="Apply" Margin="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
