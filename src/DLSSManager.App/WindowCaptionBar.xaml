<UserControl x:Class="DLSSManager.App.WindowCaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="32" Focusable="False">
    <Grid Background="{StaticResource CaptionBackground}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                <Button Style="{StaticResource CaptionMinimizeButton}" Click="MinimizeWindow"/>
                <Button Style="{StaticResource CaptionCloseButton}" Click="CloseWindow"/>
            </StackPanel>
            <Image DockPanel.Dock="Left" Source="/DLSSManager.App;component/Manager.ico" Width="16" Height="16" Margin="8,0,6,0"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"
                       Foreground="#94A3B8" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="Medium"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border VerticalAlignment="Bottom" Height="1" Background="#0FFFFFFF" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
