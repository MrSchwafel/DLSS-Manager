                                    <Button Content="{local:Loc Workspace.CheckBetaAndRCReleases}" Command="{Binding CheckBetaRelease}"/>
                                    <Button Content="{local:Loc Workspace.ExportDiagnostics}" Command="{Binding ExportDiagnosis}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
</Window>
