<Window x:Class="DLSSManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DLSSManager.App" Title="{Binding AppVersion, StringFormat='DLSS Manager {0}', FallbackValue='DLSS Manager'}" Icon="Manager.ico" Height="865" Width="1440" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" Style="{StaticResource CustomCaptionWindow}">
    <Window.Resources>
        <local:ScanGameIconConverter x:Key="ScanGameIcon"/>
        <Style x:Key="SelectedGameVisibility" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLibraryGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedGameDock" TargetType="DockPanel" BasedOn="{StaticResource SelectedGameVisibility}"/>
        <Style x:Key="SelectedGameWrap" TargetType="WrapPanel" BasedOn="{StaticResource SelectedGameVisibility}"/>
        <Style x:Key="SelectedGameStack" TargetType="StackPanel" BasedOn="{StaticResource SelectedGameVisibility}"/>
        <Style x:Key="EmptyLibrarySurface" TargetType="Border" BasedOn="{StaticResource DetailSurface}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedLibraryGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModProxyPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="125"/>
        </Style>
        <Style x:Key="SidebarAction" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <ContextMenu x:Key="DriverRollbackMenu" Style="{StaticResource DriverRollbackContextMenu}"
                     ItemsSource="{Binding RollbackMenuItems}"
                     ItemContainerStyle="{StaticResource DriverRollbackDynamicMenuItem}">
            <ContextMenu.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource InspectorGlyph}" FontSize="11"
                                   Foreground="#94A3B8" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ReleaseDate}" Foreground="#94A3B8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding HasReleaseDate, Converter={StaticResource ShowWhenTrue}}"/>
                        <Border Style="{StaticResource RollbackHotfixBadge}" Margin="7,0,0,0"
                                Visibility="{Binding ShowHotfixBadge, Converter={StaticResource ShowWhenTrue}}">
                            <TextBlock Text="{local:Loc Drivers.Hotfix}"/>
                        </Border>
                        <Border Style="{StaticResource RollbackWhqlBadge}" Margin="7,0,0,0"
                                Visibility="{Binding ShowWhqlBadge, Converter={StaticResource ShowWhenTrue}}">
                            <TextBlock Text="{local:Loc Drivers.WHQL}"/>
                        </Border>
                        <Border Style="{StaticResource RollbackCachedBadge}" Margin="5,0,0,0"
                                Visibility="{Binding IsCached, Converter={StaticResource ShowWhenTrue}}">
                            <TextBlock Text="{local:Loc Drivers.Cached}"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ContextMenu.ItemTemplate>
        </ContextMenu>
    </Window.Resources>
    <TabControl BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" SelectedIndex="{Binding SelectedTab}">
<TabControl.Template>
    <ControlTemplate TargetType="TabControl">
        <Grid x:Name="WindowLayout" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,1,0">
                <Grid Margin="12,18,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel Margin="2,0,0,10">
                                <Border DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,11,0" Background="#1C2029" BorderBrush="#76B900" BorderThickness="1" CornerRadius="10"><Image Source="{DynamicResource BrandImage}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc Workspace.DLSSManager}" FontSize="18" FontWeight="Bold"/>
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Mono}"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{local:Loc Workspace.MANAGEMENT}" Style="{StaticResource DetailLabel}" Margin="8,0,0,4"/>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            <TextBlock Text="{local:Loc Workspace.QUICKACTIONS}" Style="{StaticResource DetailLabel}" Margin="8,10,0,4"/>
                            <Button Content="{local:Loc Workspace.StartQuickScan}" Command="{Binding QuickScan}" Style="{StaticResource SidebarAction}"/>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverlayStatus}" FontSize="10">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding OverlayEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            </DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <CheckBox Content="{local:Loc Workspace.NVIDIADLSSIndicator}" Command="{Binding ToggleOverlay}"
                                          IsChecked="{Binding OverlayEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button Command="{Binding ClearShaderCache}" Style="{StaticResource SidebarAction}">
                                <TextBlock Text="{local:Loc Workspace.ClearNVIDIAShaderCache}" FontSize="12" TextWrapping="Wrap"/>
                            </Button>
                            <Button Content="{local:Loc Workspace.OpenBackupFolder}" Command="{Binding OpenBackupFolder}" Style="{StaticResource SidebarAction}" Margin="0"/>
                            <WrapPanel Margin="0,5,0,0">
                                <WrapPanel.Style><Style TargetType="WrapPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="DllCatalog.DLLCatalog">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style></WrapPanel.Style>
                                <Button Content="{local:Loc Updates.UpdateAll}" Command="{Binding BatchUpdate}"/>
                                <Button Content="{local:Loc Workspace.Game}" Command="{Binding AddGame}" Style="{StaticResource Secondary}" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="SidebarSystemCard" Grid.Row="1" Style="{StaticResource DetailSurface}" Padding="10,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Gpu.Text}" TextWrapping="Wrap" FontSize="12"/>
                            <DockPanel Margin="0,6,0,0">
                                <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDriverUpdate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></DockPanel.Style>
                                <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefreshSystem}" ToolTip="{local:Loc Workspace.CheckForDriverAndAppUpdates}" Padding="5,0" MinHeight="22" Margin="4,0,0,0"/>
                                <Button Foreground="{Binding DriverColor}" Command="{Binding OpenDriverPage}" HorizontalContentAlignment="Left"
                                        Margin="0" Padding="5,0" MinHeight="22" ToolTip="{Binding DriverStatus.Text}">
                                    <TextBlock Text="{Binding DriverStatus.Text}" TextWrapping="Wrap"/>
                                </Button>
                            </DockPanel>
                            <DockPanel x:Name="RollbackSplitBar" Margin="0,5,0,0"
                                      Visibility="{Binding ShowRollbackSplitBar, Converter={StaticResource ShowWhenTrue}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource DriverRollbackSplitMenuButton}"
                                        Tag="{Binding ElementName=RollbackSplitBar}" ContextMenu="{StaticResource DriverRollbackMenu}"
                                        Click="OpenRollbackMenu" ToolTip="{local:Loc Workspace.SelectAPreviousDriverHotfixWHQL}"
                                        AutomationProperties.Name="{local:Loc Workspace.SelectPreviousDriver}">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource InspectorGlyph}" FontSize="9.5"/>
                                </Button>
                                <Button Style="{StaticResource DriverRollbackSplitMainButton}" Tag="{Binding RollbackVisualKind}"
                                        Command="{Binding PrimaryRollbackAction}" ToolTip="{Binding RollbackButtonToolTip}"
                                        ContextMenu="{StaticResource DriverRollbackMenu}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RollbackButtonGlyph}" Style="{StaticResource InspectorGlyph}"
                                                   FontSize="11" Foreground="#FBBF24" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding RollbackButtonLabel}" FontSize="11.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding HasDriverUpdate, Converter={StaticResource ShowWhenTrue}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource DriverRollbackIconButton}" Tag="{Binding RollbackVisualKind}"
                                        ContextMenu="{StaticResource DriverRollbackMenu}" Click="HandleRollbackIconClick"
                                        ToolTip="{Binding RollbackIconToolTip}"
                                        AutomationProperties.Name="{local:Loc Workspace.RollBackToThePreviousAvailableDriver}"
                                        Visibility="{Binding ShowRollbackIconButton, Converter={StaticResource ShowWhenTrue}}">
                                    <TextBlock Text="{Binding RollbackButtonGlyph}" Style="{StaticResource InspectorGlyph}" FontSize="12"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DriverSplitIconButton}" Content="↗"
                                        Command="{Binding OpenDriverReleasePage}" ToolTip="{Binding DriverReleasePageToolTip}"
                                        Visibility="{Binding ShowDriverReleaseButton, Converter={StaticResource ShowWhenTrue}}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DriverSplitIconButton}"
                                        Command="{Binding OpenDriverCacheFolder}" ToolTip="{local:Loc Workspace.OpenDriverDownloadFolderInExplorer}"
                                        Visibility="{Binding ShowDriverFolderButton, Converter={StaticResource ShowWhenTrue}}">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource InspectorGlyph}"/>
                                </Button>
                                <Button Style="{StaticResource DriverSplitMainButton}" Tag="{Binding DriverVisualKind}"
                                        Command="{Binding PrimaryDriverAction}" ToolTip="{Binding DriverButtonToolTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Background="{StaticResource Elevated}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Outline}">
                                            <MenuItem Header="{local:Loc Workspace.OpenReleaseNotesInBrowser}" Command="{Binding OpenDriverReleasePage}"/>
                                            <MenuItem Header="{local:Loc Workspace.InstallInteractively}" Command="{Binding InstallDriverInteractive}"
                                                      Visibility="{Binding IsDriverDownloaded, Converter={StaticResource ShowWhenTrue}}"/>
                                            <MenuItem Header="{local:Loc Drivers.OpenDownloadFolder}" Command="{Binding OpenDriverCacheFolder}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DriverButtonGlyph}" Style="{StaticResource InspectorGlyph}" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding DriverButtonLabel}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefreshSystem}" ToolTip="{local:Loc Workspace.CheckForDriverAndAppUpdates}"
                                        Padding="5,0" MinHeight="22" Margin="4,0,0,0"
                                        Visibility="{Binding HasDriverUpdate, Converter={StaticResource ShowWhenTrue}}"/>
                                <Button Content="{local:Loc Workspace.OpenNVIDIAApp}" Command="{Binding OpenNvidia}" HorizontalAlignment="Left" Padding="5,0" MinHeight="22" Margin="0"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CatalogSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DrsStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding LibraryHealth}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding HasUpdateDrift}" Value="True"><Setter Property="Foreground" Value="#F7C56C"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="{Binding LibraryStorageSummary}" Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <StackPanel Margin="0,5,0,0" Visibility="{Binding IsBusy, Converter={StaticResource ShowWhenTrue}}">
                                <TextBlock Text="{Binding Status.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status.Text}"
                                           AutomationProperties.LiveSetting="Polite" FontSize="11"/>
                                <DockPanel Margin="0,5,0,0">
                                    <Button DockPanel.Dock="Right" Content="{local:Loc Common.Cancel}" Command="{Binding Cancel}" Style="{StaticResource InspectorButton}"
                                            Height="26" MinHeight="26" Margin="5,0,0,0"/>
                                    <ProgressBar Height="3" VerticalAlignment="Center" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding AppUpdateLabel.Text}" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdateLabel.Text}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DockPanel Grid.Column="1" Margin="14,12,14,10">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="DllCatalog.DLLCatalog">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Library.Title">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Recovery.Title">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="{local:Loc Updates.UpdateAll}" Command="{Binding BatchUpdate}"/>
                            <Button Content="{local:Loc Workspace.Game}" Style="{StaticResource Secondary}" Command="{Binding AddGame}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Text="{local:Loc Path=SelectedItem.Tag, KeyFromPath=True, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource PageHeading}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </DockPanel>
            <Border x:Name="DynamicIsland" Grid.Column="1" Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    MaxWidth="580" Margin="14,0,14,14" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Background" Value="#273920"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast.Text}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Active">
                            <Setter Property="Background" Value="#1D2B3A"/>
                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                            <Setter Property="Background" Value="#422D1D"/>
                            <Setter Property="BorderBrush" Value="#F7C56C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style></Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissToast}" Margin="10,0,0,0" Padding="7,2"
                            MinHeight="25" AutomationProperties.Name="{local:Loc Workspace.DismissNotification}"/>
                    <Button DockPanel.Dock="Right" Content="{Binding ToastActionLabel.Text}" Command="{Binding InvokeToastAction}"
                            Visibility="{Binding HasToastAction, Converter={StaticResource ShowWhenTrue}}"
                            Margin="10,0,0,0" Padding="8,2" MinHeight="25"/>
                    <ScrollViewer MaxHeight="48" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Toast.Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ControlTemplate>
</TabControl.Template>
            <TabItem Tag="Library.Title"><TabItem.Header><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding LibraryBadge}" Style="{StaticResource Mono}"/></Border><TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;"/><TextBlock Text="{local:Loc Library.Title}" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
                <DockPanel Margin="8,0,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" MinWidth="215"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition MinWidth="340"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{local:Loc Library.Title}" FontSize="21" FontWeight="Bold" Margin="0,3,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearSearch}" Margin="5,0,0,0" AutomationProperties.Name="{local:Loc Workspace.ClearSearch}"/>
                                    <Grid>
                                        <TextBox AutomationProperties.Name="{local:Loc Workspace.SearchByGameOrPath}" Text="{Binding LibraryQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{local:Loc Workspace.SearchByGameOrPath2}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,0" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding LibraryQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <WrapPanel Margin="0,8,0,3" AutomationProperties.Name="{local:Loc Workspace.QuickFilters}">
                                    <Button Style="{StaticResource AllLibraryFilterChip}" Tag="All" Click="SelectLibraryFilter"
                                            Content="{local:Loc Common.All}" ToolTip="{local:Loc Common.AllCount, Path=FilterCounts.All}"/>
                                    <Button Style="{StaticResource DlssLibraryFilterChip}" Tag="WithDlss" Click="SelectLibraryFilter"
                                            Content="{local:Loc Library.WithDlss}" ToolTip="{local:Loc Common.WithDLSS, Path=FilterCounts.Dlss}"/>
                                    <Button Style="{StaticResource FrameGenLibraryFilterChip}" Tag="WithFrameGeneration" Click="SelectLibraryFilter"
                                            Content="{local:Loc Library.WithFrameGeneration}" ToolTip="{local:Loc Common.WithFG, Path=FilterCounts.FrameGen}"/>
                                    <Button Style="{StaticResource BackupLibraryFilterChip}" Tag="ChangedDll" Click="SelectLibraryFilter"
                                            Content="{local:Loc Library.ChangedDll}" ToolTip="{local:Loc Common.DLLChanged, Path=FilterCounts.Backup}"/>
                                    <Button Style="{StaticResource UnlockerLibraryFilterChip}" Tag="Unlocker" Click="SelectLibraryFilter"
                                            Content="{local:Loc Mods.Unlocker}" ToolTip="{local:Loc Common.FGMFGUnlocker, Path=FilterCounts.Unlocker}"/>
                                    <Button Style="{StaticResource OptiScalerLibraryFilterChip}" Tag="OptiScaler" Click="SelectLibraryFilter"
                                            Content="{local:Loc Mods.OptiScaler}" ToolTip="{local:Loc Common.OptiScaler, Path=FilterCounts.OptiScaler}"/>
                                </WrapPanel>
                                <ComboBox ItemsSource="{Binding LibraryFilterOptions}" SelectedValue="{Binding LibraryFilter}"
                                          SelectedValuePath="Code" ItemTemplate="{StaticResource LocalizedOptionLabel}"
                                          AutomationProperties.Name="{local:Loc Workspace.FilterByLauncherOrStatus}"/>
                                <TextBlock Text="{Binding LibraryCount}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="8,12"
                                        Visibility="{Binding ShowEmptyLibraryFilter, Converter={StaticResource ShowWhenTrue}}">
                                <TextBlock Text="{local:Loc Workspace.NoGamesMatchThisFilter}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <Button Content="{local:Loc Workspace.ResetFilters}" Command="{Binding ResetLibraryFilters}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                            <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedLibraryGame}"
                                      MouseDoubleClick="LaunchLibraryGame" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ItemContainerStyle="{StaticResource GameRow}" BorderThickness="0" Background="Transparent">
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{local:Loc Workspace.LaunchGame}" Command="{Binding LaunchGame}"/>
                                <MenuItem Header="{local:Loc Workspace.OpenFolder}" Command="{Binding OpenGameFolder}"/>
                                <MenuItem Header="{local:Loc Workspace.ChooseGameIcon}" Command="{Binding ChooseGameIcon}"/>
                                <MenuItem Header="{local:Loc Workspace.UseAutomaticIcon}" Command="{Binding ResetGameIcon}"/>
                                <MenuItem Header="{local:Loc Workspace.EditEntry}" Command="{Binding EditGame}"/>
                                <MenuItem Header="{local:Loc Workspace.ExcludeInclude}" Command="{Binding ToggleIgnored}"/>
                                <MenuItem Header="{local:Loc Workspace.RemoveEntry}" Command="{Binding RemoveGame}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#263852" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid>
                                                    <TextBlock x:Name="FallbackIcon" Visibility="Collapsed" Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                                                    <Image Source="{Binding IconImage}" Width="24" Height="24" x:Name="GameIcon"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource LauncherLibraryBadge}" Margin="4,0,0,0">
                                                        <TextBlock Text="{local:Loc Path=LauncherLabelKey, KeyFromPath=True}" Style="{StaticResource LibraryBadgeText}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,-5"
                                                       Visibility="{Binding HasLibraryBadges, Converter={StaticResource ShowWhenTrue}}">
                                                <Border Style="{StaticResource DlssLibraryBadge}"
                                                        Visibility="{Binding HasSr, Converter={StaticResource ShowWhenTrue}}" ToolTip="{local:Loc Workspace.DLSSSuperResolutionDLLDetected}">
                                                    <TextBlock Text="{Binding SrBadge}" Style="{StaticResource LibraryBadgeText}"/>
                                                </Border>
                                                <Border Style="{StaticResource FgLibraryBadge}"
                                                        Visibility="{Binding HasFg, Converter={StaticResource ShowWhenTrue}}" ToolTip="{local:Loc Workspace.FrameGenerationDLLDetected}">
                                                    <TextBlock Text="{Binding FgBadge}" Style="{StaticResource LibraryBadgeText}"/>
                                                </Border>
                                                <Border Style="{StaticResource BackupLibraryBadge}"
                                                        Visibility="{Binding HasBackup, Converter={StaticResource ShowWhenTrue}}" ToolTip="{local:Loc Workspace.OriginalDLLReplacedBackupAvailable}">
                                                    <TextBlock Text="{local:Loc Library.ChangedDll}" Style="{StaticResource LibraryBadgeText}"/>
                                                </Border>
                                                <Border Style="{StaticResource UnlockerLibraryBadge}"
                                                        Visibility="{Binding HasUnlocker, Converter={StaticResource ShowWhenTrue}}" ToolTip="{local:Loc Workspace.FGMFGUnlockerSM86Installed}">
                                                    <TextBlock Text="{local:Loc Mods.Unlocker}" Style="{StaticResource LibraryBadgeText}"/>
                                                </Border>
                                                <Border Style="{StaticResource OptiScalerLibraryBadge}"
                                                        Visibility="{Binding HasOptiScaler, Converter={StaticResource ShowWhenTrue}}" ToolTip="{local:Loc Workspace.OptiScalerInstalled}">
                                                    <TextBlock Text="{local:Loc Mods.OptiScaler}" Style="{StaticResource LibraryBadgeText}"/>
                                                </Border>
                                            </WrapPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Source, ElementName=GameIcon}" Value="{x:Null}">
                                                <Setter TargetName="GameIcon" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{StaticResource Outline}" ResizeBehavior="PreviousAndNext"/>
