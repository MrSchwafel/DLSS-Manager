                                                                BorderBrush="Transparent" Background="Transparent" Height="24" MinHeight="24" Padding="4,0"
                                                                Margin="4,0,0,0" ToolTip="NVIDIA App öffnen" AutomationProperties.Name="NVIDIA App öffnen">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="NVIDIA App" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="&#xE8A7;" FontSize="10" Style="{StaticResource InspectorGlyph}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="Profi-Tweaks &amp; Presets" FontSize="15" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding PresetStatus}" Foreground="{StaticResource Muted}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <CheckBox IsChecked="{Binding GameOverlay, Mode=OneWay}" Command="{Binding ToggleGameOverlay}" Margin="0,8,0,0">
                                                        <TextBlock Text="DLSS-Indikator beim Direktstart" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding GamePreset}" DisplayMemberPath="Label"
                                                              Tag="Preset wählen…" MinHeight="28" AutomationProperties.Name="DLSS SR Preset" Margin="0,8,0,0"/>
                                                    <WrapPanel Margin="0,6,0,-6">
                                                        <Button Content="Profil lesen" Height="28" MinHeight="28" Padding="10,0" Margin="0,0,6,6"
                                                                Style="{StaticResource InspectorButton}" Command="{Binding ReadPreset}"/>
                                                        <Button Content="Preset anwenden" Height="28" MinHeight="28" Padding="10,0" Margin="0,0,6,6"
                                                                Style="{StaticResource InspectorAccentButton}" Command="{Binding SavePreset}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Border Style="{StaticResource DetailSurface}" Padding="12,10">
                                            <Expander FontSize="13" Foreground="{StaticResource Ink}" AutomationProperties.Name="Hinweise und Messwerte">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Logs.Length, StringFormat='Hinweise &amp; Messwerte ({0})'}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                                                </Expander.Header>
                                                <StackPanel Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding Logs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3"/></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Tag="DLL-Katalog"><TabItem.Header><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding CatalogBadge}" Style="{StaticResource Mono}"/></Border><TextBlock DockPanel.Dock="Right" Text="●" Foreground="{StaticResource Accent}" Visibility="{Binding ModUpdatesAvailable, Converter={StaticResource ShowWhenTrue}}" Margin="0,0,4,0"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;"/><TextBlock Text="DLL-Katalog" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
                <local:DllCatalogView/>
            </TabItem>

            <TabItem Tag="Wiederherstellung"><TabItem.Header><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding BackupBadge}" Style="{StaticResource Mono}"/></Border><TextBlock Style="{StaticResource Glyph}" Text="&#xE777;"/><TextBlock Text="Wiederherstellung" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
                <local:RecoveryView/>
            </TabItem>
            <TabItem Tag="Scan"><TabItem.Header><StackPanel><TextBlock Text="WERKZEUGE" Style="{StaticResource DetailLabel}" Margin="0,8,0,5"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LastScanLabel}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/><TextBlock Text="Scan" VerticalAlignment="Center"/></DockPanel></StackPanel></TabItem.Header>
                <DockPanel Margin="8,0,0,0">

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <Button Content="Launcher scannen" Style="{StaticResource Secondary}" Command="{Binding ScanLaunchers}"/>
                        <Button Content="Alle Laufwerke" Command="{Binding ScanDrives}"/>
                        <Button Content="Ordner scannen" Command="{Binding ScanFolder}"/>
                        <Button Content="Auswahl hinzufügen" Style="{StaticResource Primary}" Command="{Binding AddDiscovery}"/>
                    </WrapPanel>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="7"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <ListView ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Spiel / Ordner" Width="240">
                                <GridViewColumn.CellTemplate><DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" x:Name="ScanIconFallback"/>
                                            <Image Source="{Binding Converter={StaticResource ScanGameIcon}}" Width="24" Height="24" x:Name="ScanIcon"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Root.Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers><Trigger SourceName="ScanIcon" Property="Source" Value="{x:Null}">
                                        <Setter TargetName="ScanIconFallback" Property="Visibility" Value="Visible"/>
                                    </Trigger></DataTemplate.Triggers>
                                </DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Quelle" Width="120" DisplayMemberBinding="{Binding Root.Launcher}"/>
                            <GridViewColumn Header="Installationspfad" Width="440" DisplayMemberBinding="{Binding Root.Path}"/>
                            <GridViewColumn Header="DLLs" Width="55" DisplayMemberBinding="{Binding Dlls.Length}"/>
                            <GridViewColumn Header="EXE-Kandidaten" Width="110" DisplayMemberBinding="{Binding Alternatives.Length}"/>
                        </GridView></ListView.View>
                    </ListView>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Outline}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,8,0">
                        <TextBlock Text="{Binding SelectedFinding.Root.Title, TargetNullValue='Spiel auswählen', FallbackValue='Spiel auswählen'}"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding EffectiveExecutable, TargetNullValue='Spiel-EXE auswählen'}"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveExecutable}"/>
                        <Expander Header="Andere Spiel-EXE auswählen" IsExpanded="{Binding NeedsExecutable, Mode=OneWay}" Margin="0,6,0,0">
                            <ListBox Style="{StaticResource ExecutablePicker}" MaxHeight="160"
                                     AutomationProperties.Name="Spiel-EXE auswählen"
                                     ItemsSource="{Binding SelectedFinding.Alternatives}" SelectedItem="{Binding SelectedExecutable}"/>
                        </Expander>
                        <TextBlock Text="DLL-Inventar" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <ListView MaxHeight="170" ItemsSource="{Binding SelectedFinding.Dlls}" SelectedItem="{Binding SelectedDll}">
                            <ListView.View><GridView>
                                <GridViewColumn Header="Typ" Width="65" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Status" Width="125" DisplayMemberBinding="{Binding Status}"/>
                                <GridViewColumn Header="Dateiversion" Width="120" DisplayMemberBinding="{Binding Version}"/>
                                <GridViewColumn Header="Produktversion" Width="130" DisplayMemberBinding="{Binding Metadata.ProductVersion}"/>
                                <GridViewColumn Header="Architektur" Width="95" DisplayMemberBinding="{Binding Metadata.Machine}"/>
                                <GridViewColumn Header="Pfad" Width="380" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="SHA-256" Width="480" DisplayMemberBinding="{Binding Metadata.Sha256}"/>
                            </GridView></ListView.View>
                        </ListView>
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox AutomationProperties.Name="Ersatzversion" Width="150" Margin="0,0,8,0"
                                      ItemsSource="{Binding ReplacementVersions}" SelectedItem="{Binding SelectedReplacement}" IsEnabled="{Binding HasReplacementVersions}"
                                      DisplayMemberPath="Version"/>
                            <Button Content="DLL austauschen" Style="{StaticResource Primary}" Command="{Binding ReplaceDll}"/>
                            <Button Content="Versionen laden" Command="{Binding RefreshCatalog}"/>
                            <Button Content="Original wiederherstellen" Command="{Binding RestoreDll}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ReplacementHint}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Expander Header="FrameGen &amp; MFG Unlocker verwalten" Margin="0,12,0,0">
                        <StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Unlocker herunterladen" Style="{StaticResource Primary}" Command="{Binding DownloadMod}"/>
                            <ComboBox AutomationProperties.Name="Unlocker-Proxy" Width="130" Margin="0,0,8,0"
                                      ItemsSource="{Binding ModProxies}" SelectedItem="{Binding SelectedModProxy}"/>
                            <Button Content="Unlocker installieren / reparieren" Command="{Binding InstallMod}"/>
                            <Button Content="Unlocker entfernen" Command="{Binding RemoveMod}"/>
                            <Button Content="Unlocker-Einstellungen" Command="{Binding EditModIni}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Unlocker-Versionen anzeigen" Command="{Binding ReadModHistory}"/>
                            <Button Content="Unlocker-Update anwenden" Command="{Binding UpdateMod}"/>
                            <ComboBox Width="160" Margin="0,0,8,0" AutomationProperties.Name="Frühere Unlocker-Version"
                                      ItemsSource="{Binding ModHistory}" SelectedItem="{Binding SelectedModHistory}"
                                      DisplayMemberPath="Display"/>
                            <Button Content="Fallback anwenden" Command="{Binding RestoreMod}"/>
                            <Button Content="Updates freigeben" Command="{Binding ResumeModUpdates}"/>
                        </WrapPanel>
                        </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="SettingsTab" Tag="Einstellungen"><TabItem.Header><DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/><TextBlock Text="Einstellungen" VerticalAlignment="Center"/></DockPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0,0,0" MaxWidth="900">
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10"><DockPanel><Border DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,11,0" Background="#1C2029" BorderBrush="#76B900" BorderThickness="1" CornerRadius="10"><Image Source="{DynamicResource BrandImage}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/></Border><StackPanel><TextBlock Text="{Binding AppVersion, StringFormat='DLSS Manager {0}'}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Open-Source-Werkzeug für Upscaler, Frame Generation und DLL-Sicherungen." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,3,0,7"/><Button Content="MrSchwafel/DLSS-Manager ↗" Command="{Binding OpenProject}" HorizontalAlignment="Left"/></StackPanel></DockPanel></Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Pfade und Backups" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding DataPath}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                                <TextBlock Text="Originale werden vor dem Überschreiben gesichert und per SHA-256 geprüft."
                                           Foreground="{StaticResource Muted}" Margin="0,7,0,8" TextWrapping="Wrap"/>
                                <WrapPanel><Button Content="Datenordner öffnen" Command="{Binding OpenDataFolder}"/><Button Content="Datenordner anpassen" Command="{Binding ChooseDataFolder}"/></WrapPanel>
                                <CheckBox Content="Launcher beim Start scannen" Command="{Binding ToggleStartupScan}" IsChecked="{Binding ScanLaunchersOnStartup, Mode=OneWay}" Margin="0,5,0,5"/>
                                <CheckBox Content="Spiele mit Anti-Cheat von der Aufnahme ausschließen" Command="{Binding ToggleAntiCheatFilter}" IsChecked="{Binding ExcludeAntiCheatGames, Mode=OneWay}" Margin="0,0,0,5"/>
                                <TextBlock Text="Benutzerdefinierte Scanordner" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ScanPaths}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                <WrapPanel>
                                    <Button Content="Ordnerliste ersetzen" Command="{Binding EditScanPaths}"/>
                                    <Button Content="Ordnerliste leeren" Command="{Binding ClearScanPaths}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Globale Mod-INI-Standards (SM86 &amp; OptiScaler)" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Globale Werte gelten bei Installation und Wiederherstellung, sofern das Spielprofil den jeweiligen Schlüssel übernimmt."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <Button Content="Globale INI-Standards konfigurieren..." Command="{Binding EditGlobalIni}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Automatische Updates" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Prüft beim App-Start und danach im gewählten Intervall. Gilt für gescannte Spiele und verwaltete Mods mit bekannter Release-Version. Laufende Spiele werden beim nächsten Durchlauf erneut geprüft."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <CheckBox Content="DLSS-, XeSS- und FSR-DLLs" IsChecked="{Binding AutoUpdateDlls, Mode=OneWay}"
                                          Command="{Binding ToggleAutoUpdateDlls}" Margin="0,0,0,6"/>
                                <CheckBox Content="FrameGen &amp; MFG Unlocker (SM86)" IsChecked="{Binding AutoUpdateUnlocker, Mode=OneWay}"
                                          Command="{Binding ToggleAutoUpdateUnlocker}" Margin="0,0,0,6"/>
                                <CheckBox Content="OptiScaler" IsChecked="{Binding AutoUpdateOptiScaler, Mode=OneWay}"
                                          Command="{Binding ToggleAutoUpdateOptiScaler}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="Prüfintervall in Minuten" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <TextBox Text="{Binding AutoUpdateIntervalText, UpdateSourceTrigger=PropertyChanged}" Width="72"
                                             AutomationProperties.Name="Prüfintervall in Minuten" Margin="0,0,8,6"/>
                                    <Button Content="Intervall speichern" Command="{Binding SaveAutoUpdateInterval}"/>
                                    <Button Content="Jetzt aktivierte Updates prüfen und anwenden" Command="{Binding RunAutoUpdates}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Proxy und NVIDIA" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Standard-Proxy für neue Spiele" Style="{StaticResource DetailLabel}"/>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding DefaultProxy}" MinWidth="125"
                                              AutomationProperties.Name="Standard-Proxy" Margin="0,0,6,5"/>
                                    <Button Content="Speichern" Command="{Binding SaveDefaults}"/>
                                </WrapPanel>
                                <CheckBox Content="Globaler DLSS-Indikator (Registry, Administratorrechte)" Margin="0,8"
                                          IsChecked="{Binding OverlayEnabled, Mode=OneWay}" Command="{Binding ToggleOverlay}"/>
                                <Button Content="NVIDIA App öffnen" Command="{Binding OpenNvidia}" HorizontalAlignment="Left"/>
                                <TextBlock Text="Batch-Zielversionen" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding BatchTargets}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                <Button Content="Batch-Ziele zurücksetzen" Command="{Binding ResetBatchTargets}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Treiber &amp; Cache" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBlock Text="Treiber-Vorschau (Hover-Card)" Style="{StaticResource DetailLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DriverTooltipPicker" ItemsSource="{Binding DriverTooltipChoices}" DisplayMemberPath="Value"
                                          SelectedValuePath="Key" SelectedValue="{Binding DriverPreviewStyle, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChooseDriverTooltipStyle}" AutomationProperties.Name="Treiber-Vorschau (Hover-Card)"
                                          HorizontalAlignment="Left" MinWidth="275" Margin="0,0,0,10"/>
                                <CheckBox Content="Stille Express-Installation für heruntergeladene Treiber (-s -noreboot)"
                                          IsChecked="{Binding SilentDriverInstall, Mode=OneWay}" Command="{Binding ToggleSilentDriverInstall}"/>
                                <TextBlock Text="Installiert Treiber-Updates automatisch ohne Setup-Fenster und ohne erzwungenen Neustart. Hinweis: Reguläre Updates behalten bestehende Einstellungen bei; bei Treiber-Downgrades wird optional eine saubere Neuinstallation (-clean) angeboten."
                                           Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="24,3,0,8"/>
                                <CheckBox Content="Treiber-Installer nach Installation automatisch löschen"
                                          IsChecked="{Binding DeleteDriverInstallerAfterInstall, Mode=OneWay}" Command="{Binding ToggleDeleteDriverInstallerAfterInstall}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="{Binding TranslateDriverSummariesLabel}"
                                          IsChecked="{Binding TranslateDriverSummaries, Mode=OneWay}" Command="{Binding ToggleTranslateDriverSummaries}"
                                          Visibility="{Binding CanTranslateDriverSummaries, Converter={StaticResource ShowWhenTrue}}"
                                          Margin="0,0,0,6"/>
                                <StackPanel Visibility="{Binding CanTranslateDriverSummaries, Converter={StaticResource ShowWhenTrue}}" Margin="24,0,0,10">
                                    <TextBlock Text="Google Cloud Translation API-Key (optional)" Style="{StaticResource DetailLabel}" Margin="0,2,0,4"/>
                                    <WrapPanel>
                                        <TextBox Text="{Binding GoogleTranslateApiKeyText, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                                 AutomationProperties.Name="Google Cloud Translation API-Key" Margin="0,0,6,4"/>
                                        <Button Content="API-Key speichern" Command="{Binding SaveGoogleTranslateApiKey}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <TextBlock Text="Leer lassen für kostenlose Google-Übersetzung. Bei Netzwerk- oder Limitfehlern wird automatisch der bereinigte englische Originaltext angezeigt."
                                               Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Eigene Hotfix-Feed-URL (JSON/RSS, optional)" Style="{StaticResource DetailLabel}" Margin="0,4,0,4"/>
                                <TextBox Text="{Binding CustomHotfixFeedUrlText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Eigene Hotfix-Feed-URL" Margin="0,0,0,6"/>
                                <TextBlock Text="Google Custom Search API (optional für custhelp.com-Suche)" Style="{StaticResource DetailLabel}" Margin="0,2,0,4"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBox Text="{Binding GoogleSearchApiKeyText, UpdateSourceTrigger=PropertyChanged}" Width="210"
                                             Tag="API-Key" AutomationProperties.Name="Google Custom Search API-Key" Margin="0,0,6,4"/>
                                    <TextBox Text="{Binding GoogleSearchCxText, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                             Tag="Search Engine ID (CX)" AutomationProperties.Name="Google Custom Search Engine ID" Margin="0,0,6,4"/>
                                    <Button Content="Hotfix-Quellen speichern" Command="{Binding SaveHotfixSourceSettings}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="{Binding ClearDriverCacheLabel}" Command="{Binding ClearDriverCache}" HorizontalAlignment="Left"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="System &amp; Autostart" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <StackPanel x:Name="AutostartOptions" Loaded="ReadAutostart">
                                    <CheckBox x:Name="AutostartItem" Content="Mit Windows starten" Click="ChangeAutostart"/>
                                    <CheckBox x:Name="AutostartMinimizedItem" Content="Minimiert im System-Tray starten"
                                              IsChecked="True" IsEnabled="False" Click="ChangeAutostart" Margin="18,6,0,0"/>
                                    <Button x:Name="MigrateAutostartItem" Content="Autostart in Aufgabenplanung übernehmen"
                                            Style="{StaticResource InspectorButton}" HorizontalAlignment="Left"
                                            Visibility="Collapsed" Click="ChangeAutostart" Margin="18,8,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="AutostartStatus" Foreground="#F7C56C" TextWrapping="Wrap" Margin="0,6,0,0"
                                           AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailSurface}">
                            <StackPanel>
                                <TextBlock Text="Bibliothek" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <WrapPanel>
                                    <Button Content="Bibliothek neu laden" Command="{Binding ReloadGames}"/>
                                    <Button Content="Bibliothek leeren" Command="{Binding ClearGames}"/>
                                    <Button Content="DLSSdb aktualisieren" Command="{Binding RefreshRtx}"/>
                                </WrapPanel>
                                <TextBlock Text="Fenster" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,7"/>
                                <CheckBox Content="Immer im Vordergrund" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                <TextBlock Text="Werkzeuge" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,7"/>
                                <WrapPanel>
                                    <Button Content="Stable-Releases prüfen" Command="{Binding CheckStableRelease}"/>
                                    <Button Content="Beta- und RC-Releases prüfen" Command="{Binding CheckBetaRelease}"/>
                                    <Button Content="Diagnose exportieren" Command="{Binding ExportDiagnosis}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
</Window>
